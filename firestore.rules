rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidTask() {
      return request.resource.data.keys().hasAll(['userId', 'title', 'status', 'type', 'priority', 'createdAt'])
        && request.resource.data.userId is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.status is number
        && request.resource.data.type is number
        && request.resource.data.priority is number
        && request.resource.data.createdAt is timestamp;
    }

    function isValidCategory() {
      return request.resource.data.keys().hasAll(['id', 'name', 'color', 'userId'])
        && request.resource.data.id is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.color is number
        && request.resource.data.userId is string;
    }

    function isValidUser() {
      return request.resource.data.keys().hasAll(['uid', 'username', 'email'])
        && request.resource.data.uid is string
        && request.resource.data.username is string
        && request.resource.data.email is string
        && (request.resource.data.createdAt is timestamp
         || request.resource.data.createdAt == null);
    }

    function isValidSubtask() {
      return request.resource.data.keys().hasAll(['taskId', 'userId', 'title', 'isDone', 'order'])
        && request.resource.data.taskId is string
        && request.resource.data.userId is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.isDone is bool
        && request.resource.data.order is number;
    }

    function isValidGroupTask() {
      return request.resource.data.keys().hasAll(['title', 'status', 'priority', 'order', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.status is number
        && request.resource.data.priority is number
        && request.resource.data.order is number
        && request.resource.data.createdAt is timestamp;
    }

    function isValidGroupSubTask() {
      return request.resource.data.keys().hasAll(['title', 'isDone', 'order'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.isDone is bool
        && request.resource.data.order is number;
    }

    function isGroupMember(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser();
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && isValidTask();
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && isValidCategory();
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /subtasks/{subtaskId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && isValidSubtask();
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /focus_sessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isGroupMember(groupId);
      allow delete: if isSignedIn()
        && resource.data.createdBy == request.auth.uid;

      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && memberId == request.auth.uid;
        allow update: if isSignedIn()
          && memberId == request.auth.uid;
        allow delete: if isSignedIn()
          && memberId == request.auth.uid;
      }

      match /tasks/{taskId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && isValidGroupTask();
        allow update: if isGroupMember(groupId);
        allow delete: if isGroupMember(groupId);

        match /subtasks/{subtaskId} {
          allow read: if isGroupMember(groupId);
          allow create: if isGroupMember(groupId)
            && isValidGroupSubTask();
          allow update: if isGroupMember(groupId);
          allow delete: if isGroupMember(groupId);
        }
      }
    }
  }
}
